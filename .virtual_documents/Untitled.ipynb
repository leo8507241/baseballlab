%%writefile -a src/fetch.py
rows=[]
def flatten_pa(logs):
    for game in logs:
        for pa  in game.get('PA_list',[]):
            pitches=[e['pitch'] for e in pa.get('events',[]) if e['type']=='PITCH' and e.get('pitch')]
            rows.append({
                'game_id':game['uniqid'],
                'data':game['date'],
                'inning':pa['inning'],
                'pa_round':pa['PA_round'],
                'batter_id':pa['batter']['uniqid'],
                'batter_name':pa['batter']['name'],
                'pitcher_id':pa['pitcher']['uniqid'],
                'pitcher_name':pa['pitcher']['name'],
                'batter_hand':pa['b_hand'],
                'ptcher_hand':pa['p_hand'],
                'result':pa['result'],
                'pitch_type':','.join(p.get('type') or '' for p in pitch),
                'pitch_code':','.join(p.get('code') or '' for p in pitch)
            })
    return rows


%%writefile -a src/fetch.py
SEASON='CPBL-2026-oB'
path=path_way/'pa'
path_way=Path(__file__).resolve().parent.parent/"data"/"raw"
def fetch_pitcher_pa(player_id,season=SEASON,refresh=True):
    path.mkdir(parents=True,exist_ok=True)
    file= path/f'{season}_{player_id}.csv'
    if file.exists() and not refresh:
        return pd.read_csv(file,dtype=str)
    data_list=fetch.get_json(f'https://www.rebas.tw/api/formal/players/{player_id}/seasons/{season}/logs')['data']
    df=pd.DataFrame(flatten_pa(data_list))
    df.to_csv(file,index=False)
    return df.astype(str)



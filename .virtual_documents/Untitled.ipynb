def fip_const(lg_er,lg_ip,lg_hr,lg_bb,lg_k):
    lg_era=(lg_er*9)/(lg_ip/3)
    return lg_era-((13*lg_hr+3*(lg_bb)-2*lg_k)/(lg_ip/3))

def fip(hr,k,bb,ip,const=2.869):
    return (13*hr+3*bb-2*k)/(ip/3)+const





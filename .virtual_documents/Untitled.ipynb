import numpy as np
from src import metrics

def log5(pa,pb):
    return (pa-pa*pb)/(pa+pb-2*pa*pb)
def game_prob(pa,pb,a_is_home,hfa=0.023):
    p=log5(pa,pb)+(hfa if a_is_home else -hfa)
    return min(max(p,0.05),0.95)



